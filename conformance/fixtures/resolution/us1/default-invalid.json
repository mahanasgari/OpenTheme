{
  "kind": "resolve",
  "rules": [
    "R-RES-003"
  ],
  "description": "Invalid selected theme falls back to specification baseline (OT-RES-003).",
  "input": {
    "themes": [
      {
        "trust": "trusted",
        "document": {
          "opentheme": "1.0",
          "id": "org.bad.theme",
          "name": "Bad"
        }
      }
    ],
    "selection": {
      "id": "org.bad.theme"
    },
    "previous": null,
    "platform": {
      "colorScheme": "light",
      "contrast": "standard",
      "forcedColors": false,
      "reducedMotion": false,
      "textScale": 1
    },
    "environment": {
      "sizeClass": "expanded",
      "locale": "en",
      "direction": "ltr"
    },
    "preferences": {},

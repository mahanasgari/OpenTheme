          "pointer": "/compatibility"
        }
      },
      {
        "code": "OT-DOC-005",
        "location": {
          "document": "theme",
          "pointer": "/provenance"
        }
      },
      {
        "code": "OT-DOC-005",
        "location": {
          "document": "theme",
          "pointer": "/seeds"
        }
      },
      {
        "code": "OT-DOC-005",
        "location": {
          "document": "theme",
          "pointer": "/version"
        }
      },
      {
        "code": "OT-RES-003",

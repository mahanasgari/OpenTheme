{
  "kind": "resolve",
  "rules": ["R-CTX-001"],
  "description": "High contrast ignores base theme color declarations; HC defaults/overlays win (R11).",
  "input": {
    "themes": [
      {
        "trust": "trusted",
        "document": {
          "opentheme": "1.0",
          "id": "org.example.hc-isolation",
          "version": "1.0.0",
          "name": "HC Isolation",
          "provenance": { "origin": "user-created" },
          "compatibility": { "catalog": "1.0" },
          "colorSchemes": { "supported": ["light"], "default": "light" },
          "seeds": {
            "light": {
              "background": { "colorSpace": "srgb", "components": [0.98, 0.97, 0.95] },
              "foreground": { "colorSpace": "srgb", "components": [0.12, 0.12, 0.14] },
              "accent": { "colorSpace": "oklch", "components": [0.55, 0.15, 250] }
            },
            "fontFamily": ["Inter", "system-ui", "sans-serif"]
          },
          "tokens": {
            "color": {
              "action": {
                "primary": {
                  "background": {
                    "$type": "color",
                    "$value": { "colorSpace": "srgb", "components": [0.9, 0.1, 0.1] }
                  }
                }
              }
            }
          },
          "contexts": [
            {
              "when": { "contrast": "high" },
              "tokens": {
                "color": {
                  "action": {
                    "primary": {
                      "background": {
                        "$value": { "colorSpace": "srgb", "components": [1, 1, 1] }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "selection": { "id": "org.example.hc-isolation" },
    "previous": null,
    "platform": {
      "colorScheme": "light",
      "contrast": "high",
      "forcedColors": false,
      "reducedMotion": false,
      "textScale": 1
    },
    "environment": { "sizeClass": "expanded", "locale": "en", "direction": "ltr" },
    "preferences": {},
    "policy": {
      "availableThemes": ["org.example.hc-isolation", "org.opentheme.baseline"]
    }
  },
  "expect": {
    "subset": true,
    "resolved": {
      "context.contrast": "high",
      "tokens.color.action.primary.background.srgb8": [255, 255, 255]
    }
  }
}

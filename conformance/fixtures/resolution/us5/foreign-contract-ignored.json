{
  "kind": "resolve",
  "rules": [
    "R-CMP-001"
  ],
  "description": "Notes-styled theme on media host \u2192 OT-CMP-001.",
  "input": {
    "themes": [
      {
        "trust": "trusted",
        "document": {
          "opentheme": "1.0",
          "id": "org.example.notes-theme",
          "version": "1.0.0",
          "name": "Harbor",
          "provenance": {
            "origin": "user-created"
          },
          "compatibility": {
            "catalog": "1.0"
          },
          "colorSchemes": {
            "supported": [
              "light"
            ],
            "default": "light"
          },
          "seeds": {
            "light": {
              "background": {
                "colorSpace": "srgb",
                "components": [
                  0.98,
                  0.97,
                  0.95
                ]
              },
              "foreground": {
                "colorSpace": "srgb",
                "components": [
                  0.12,
                  0.12,
                  0.14
                ]
              },
              "accent": {
                "colorSpace": "oklch",
                "components": [
                  0.55,
                  0.15,
                  250
                ]
              }
            },
            "fontFamily": [
              "system-ui",
              "sans-serif"
            ]
          },
          "components": {
            "com.example.notes/timeline": {
              "contract": "1.0",
              "parts": {
                "container": {
                  "background": "{color.surface.raised}"
                }
              }
            }
          }
        }
      }
    ],
    "selection": {
      "id": "org.example.notes-theme"
    },
    "previous": null,
    "platform": {
      "colorScheme": "light",
      "contrast": "standard",
      "forcedColors": false,
      "reducedMotion": false,
      "textScale": 1
    },
    "environment": {
      "sizeClass": "expanded",
      "locale": "en",
      "direction": "ltr"
    },
    "preferences": {},
    "policy": {
      "availableThemes": [
        "org.example.notes-theme",
        "org.opentheme.baseline"
      ],
      "defaultTheme": "org.opentheme.baseline"
    },
    "host": {
      "openthemeHost": "1.0",
      "id": "com.example.media",
      "catalog": "1.0",
      "consumes": {
        "tokens": [
          "color.*",
          "font.*",
          "space.*",
          "radius.*",
          "motion.*",
          "size.*"
        ],
        "contracts": [
          "std/button@1",
          "std/dialog@1",
          "std/nav-bar@1"
        ]
      },
      "tokens": {
        "color": {
          "$type": "color",
          "scrubber": {
            "$description": "Progress track fill for media playback.",
            "$value": "{color.action.primary.background}"
          }
        }
      },
      "contracts": [
        {
          "id": "com.example.media/player-controls",
          "version": "1.0.0",
          "description": "Transport controls for media playback.",
          "parts": [
            "container",
            "play",
            "scrubber"
          ],
          "states": [
            "default",
            "hover",
            "pressed",
            "disabled"
          ],
          "properties": {
            "container": {
              "background": "color",
              "padding": "dimension"
            },
            "play": {
              "background": "color",
              "icon-color": "color"
            },
            "scrubber": {
              "fill": "color",
              "track": "color",
              "height": "dimension"
            }
          },
          "defaults": {
            "container": {
              "background": "{color.surface.raised}",
              "padding": "{space.3}"
            },
            "play": {
              "background": "{color.action.primary.background}",
              "icon-color": "{color.action.primary.text}"
            },
            "scrubber": {
              "fill": "{com.example.media/color.scrubber}",
              "track": "{color.border.subtle}",
              "height": "{size.control.height.sm}"
            }
          },
          "pairs": [
            {
              "foreground": "play.icon-color",
              "background": "play.background",
              "kind": "text"
            }
          ],
          "interactiveParts": [
            "play",
            "scrubber"
          ]
        },
        {
          "id": "com.example.media/playlist-row",
          "version": "1.0.0",
          "description": "Single row in a media playlist.",
          "parts": [
            "container",
            "title",
            "duration"
          ],
          "states": [
            "default",
            "hover",
            "selected",
            "focus-visible"
          ],
          "properties": {
            "container": {
              "background": "color",
              "min-height": "dimension"
            },
            "title": {
              "color": "color",
              "typography": "typography"
            },
            "duration": {
              "color": "color",
              "typography": "typography"
            }
          },
          "defaults": {
            "container": {
              "background": "{color.surface.base}",
              "min-height": "{size.control.height.md}"
            },
            "title": {
              "color": "{color.text.primary}",
              "typography": "{text.body}"
            },
            "duration": {
              "color": "{color.text.secondary}",
              "typography": "{text.caption}"
            }
          },
          "pairs": [
            {
              "foreground": "title.color",
              "background": "container.background",
              "kind": "text"
            },
            {
              "foreground": "duration.color",
              "background": "container.background",
              "kind": "text"
            }
          ],
          "interactiveParts": [
            "container"
          ]
        }
      ],
      "layoutVariants": {
        "library": {
          "variants": [
            "list",
            "grid"
          ],
          "default": "list"
        }
      }
    }
  },
  "expect": {
    "subset": true,
    "resolved": {
      "applied.fallback": "none"
    },
    "diagnostics": [
      {
        "code": "OT-CMP-001",
        "severity": "info",
        "location": {
          "document": "theme",
          "pointer": "/components/com.example.notes~1timeline"
        },
        "rule": "R-CMP-001"
      }
    ]
  }
}

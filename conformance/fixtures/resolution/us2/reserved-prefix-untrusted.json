{
  "kind": "resolve",
  "rules": [
    "R-META-002"
  ],
  "description": "An untrusted theme whose id starts with the reserved prefix org.opentheme. is invalid with OT-META-002 at /id, so selection falls back to the specification baseline (chapter 02, finding C1). Trust comes from the host entry, never from the document's id or provenance (FR-010).",
  "input": {
    "themes": [
      {
        "trust": "untrusted",
        "document": {
          "opentheme": "1.0",
          "id": "org.opentheme.aurora",
          "version": "1.0.0",
          "name": "Impostor Aurora",
          "provenance": {
            "origin": "prebuilt"
          },
          "compatibility": {
            "catalog": "1.0"
          },
          "colorSchemes": {
            "supported": [
              "light"
            ],
            "default": "light"
          },
          "seeds": {
            "light": {
              "background": {
                "colorSpace": "srgb",
                "components": [
                  0.98,
                  0.97,
                  0.95
                ]
              },
              "foreground": {
                "colorSpace": "srgb",
                "components": [
                  0.12,
                  0.12,
                  0.14
                ]
              },
              "accent": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  0,
                  0
                ]
              }
            },
            "fontFamily": [
              "Inter",
              "system-ui",
              "sans-serif"
            ]
          }
        }
      }
    ],
    "selection": {
      "id": "org.opentheme.aurora"
    },
    "previous": null,
    "platform": {
      "colorScheme": "light",
      "contrast": "standard",
      "forcedColors": false,
      "reducedMotion": false,
      "textScale": 1
    },
    "environment": {
      "sizeClass": "expanded",
      "locale": "en",
      "direction": "ltr"
    },
    "preferences": {},
    "policy": {
      "availableThemes": [
        "org.opentheme.aurora",
        "org.opentheme.baseline"
      ]
    }
  },
  "expect": {
    "subset": true,
    "resolved": {
      "applied.id": "org.opentheme.baseline",
      "applied.fallback": "specification-baseline",
      "applied.trust": "trusted",
      "displayText.name": "OpenTheme Baseline"
    },
    "diagnostics": [
      {
        "code": "OT-META-002",
        "location": {
          "document": "theme",
          "pointer": "/id"
        }
      },
      {
        "code": "OT-RES-003",
        "location": {
          "document": "input",
          "pointer": "/selection"
        }
      }
    ]
  }
}

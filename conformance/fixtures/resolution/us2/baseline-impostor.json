      "colorScheme": "light",
      "contrast": "standard",
      "forcedColors": false,
      "reducedMotion": false,
      "textScale": 1
    },
    "environment": {
      "sizeClass": "expanded",
      "locale": "en",
      "direction": "ltr"
    },
    "preferences": {},
    "policy": {
      "availableThemes": [
        "org.example.missing",
        "org.opentheme.baseline"
      ]
    }
  },
  "expect": {
    "subset": true,
    "resolved": {
      "applied.id": "org.opentheme.baseline",
      "applied.fallback": "specification-baseline",
      "applied.trust": "trusted",
      "displayText.name": "OpenTheme Baseline"
    },
    "diagnostics": [
      {
        "code": "OT-RES-003",
        "location": {
          "document": "input",
          "pointer": "/selection"
        }
      },
      {
        "code": "OT-SEC-001",
        "location": {
          "document": "input",
          "pointer": "/themes"
        }
      }
    ]

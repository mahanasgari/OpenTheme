{
  "kind": "validate",
  "rules": [
    "R-A11Y-005"
  ],
  "description": "The same in a high-contrast overlay \u2192 OT-A11Y-005, and the focus pair fails 3:1 (OT-A11Y-002).",
  "input": {
    "theme": {
      "opentheme": "1.0",
      "id": "org.example.probe",
      "version": "1.0.0",
      "name": "Quiet Paper",
      "provenance": {
        "origin": "user-created"
      },
      "compatibility": {
        "catalog": "1.0"
      },
      "colorSchemes": {
        "supported": [
          "light"
        ],
        "default": "light"
      },
      "seeds": {
        "light": {
          "background": {
            "colorSpace": "srgb",
            "components": [
              0.98,
              0.97,
              0.95
            ]
          },
          "foreground": {
            "colorSpace": "srgb",
            "components": [
              0.12,
              0.12,
              0.14
            ]
          },
          "accent": {
            "colorSpace": "oklch",
            "components": [
              0.55,
              0.15,
              250
            ]
          }
        },
        "fontFamily": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "contexts": [
        {
          "when": {
            "contrast": "high"
          },
          "tokens": {
            "color": {
              "focus": {
                "$value": {
                  "colorSpace": "srgb",
                  "components": [
                    0.2,
                    0.4,
                    0.9
                  ],
                  "alpha": 0
                }
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "validity": "invalid",
    "diagnostics": [
      {
        "code": "OT-A11Y-002",
        "location": {
          "document": "theme",
          "pointer": "/contexts/0/tokens/color/focus"
        }
      },
      {
        "code": "OT-A11Y-005",
        "location": {
          "document": "theme",
          "pointer": "/contexts/0/tokens/color/focus/$value"
        }
      }
    ]
  }
}

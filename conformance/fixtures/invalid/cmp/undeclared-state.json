{
  "kind": "validate",
  "rules": [
    "R-CMP-004"
  ],
  "description": "A state the host contract does not declare → OT-CMP-004.",
  "input": {
    "theme": {
      "opentheme": "1.0",
      "id": "org.example.quiet-paper",
      "version": "1.0.0",
      "name": "Quiet Paper",
      "provenance": {
        "origin": "user-created"
      },
      "compatibility": {
        "catalog": "1.0"
      },
      "colorSchemes": {
        "supported": [
          "light"
        ],
        "default": "light"
      },
      "seeds": {
        "light": {
          "background": {
            "colorSpace": "srgb",
            "components": [
              0.98,
              0.97,
              0.95
            ]
          },
          "foreground": {
            "colorSpace": "srgb",
            "components": [
              0.12,
              0.12,
              0.14
            ]
          },
          "accent": {
            "colorSpace": "oklch",
            "components": [
              0.55,
              0.15,
              250
            ]
          }
        },
        "fontFamily": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "components": {
        "com.example.notes/timeline": {
          "parts": {
            "marker": {
              "color": {
                "$states": {
                  "default": "{color.text.primary}",
                  "pressed": "{color.text.primary}"
                }
              }
            }
          }
        }
      }
    },
    "host": {
      "$file": "specification/hosts/com.example.notes.opentheme-host.json"
    }
  },
  "expect": {
    "validity": "invalid",
    "diagnostics": [
      {
        "code": "OT-CMP-004",
        "severity": "error",
        "location": {
          "document": "theme",
          "pointer": "/components/com.example.notes~1timeline/parts/marker/color/$states/pressed"
        },
        "rule": "R-CMP-004"
      }
    ]
  }
}

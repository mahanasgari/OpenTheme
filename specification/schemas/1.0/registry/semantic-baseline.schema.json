{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/registry/semantic-baseline.schema.json",
  "type": "object",
  "required": ["version", "tokens", "pairs", "distinguishable", "distinguishableThreshold"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "description": "Specification version.", "examples": ["1.0.0-draft.1"] },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "description", "example"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "example": true,
          "default": true,
          "highContrastDefault": true,
          "forcedColor": { "type": ["string", "null"] },
          "reducedMotionDefault": true,
          "range": true,
          "deprecated": true,
          "reserved": { "type": "boolean" }
        }
      }
    },
    "pairs": { "type": "array", "items": { "type": "object" } },
    "distinguishable": { "type": "array", "items": { "type": "object" } },
    "distinguishableThreshold": { "type": "number" }
  }
}

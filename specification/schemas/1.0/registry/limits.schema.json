{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/registry/limits.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Specification version of this registry.",
      "examples": [
        "1.0.0-draft.3"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "description",
          "example"
        ],
        "properties": {
          "value": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "example": {}
        }
      }
    }
  }
}

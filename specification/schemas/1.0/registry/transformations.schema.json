{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/registry/transformations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "transformations"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Specification version of this registry.",
      "examples": [
        "1.0.0-draft.1"
      ]
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "outputType",
          "effortCost",
          "arguments",
          "example"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "outputType": {
            "type": "string"
          },
          "effortCost": {
            "type": "integer",
            "minimum": 1
          },
          "arguments": {
            "type": "array"
          },
          "example": {}
        }
      }
    }
  }
}

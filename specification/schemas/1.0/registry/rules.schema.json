{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/registry/rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Specification version of this registry.",
      "examples": [
        "1.0.0-draft.4"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapter",
          "requirements",
          "summary",
          "fixtures",
          "description",
          "example"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[A-Z0-9]+-[0-9]{3}$"
          },
          "chapter": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "fixtures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "example": {},
          "retired": {
            "type": "string",
            "minLength": 1,
            "description": "Present when the entry is retired: why, and that it is never reported."
          }
        }
      }
    }
  }
}

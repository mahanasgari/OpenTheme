{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/host-declaration.schema.json",
  "title": "OpenTheme Host Declaration",
  "description": "Host declaration shape per contracts/host-declaration.md and data-model §13.",
  "type": "object",
  "additionalProperties": false,
  "required": ["openthemeHost", "id", "catalog"],
  "properties": {
    "openthemeHost": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Targeted Theme Specification MAJOR.MINOR for the host declaration.",
      "examples": ["1.0"]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!std(?:\\.|$)|org\\.opentheme(?:\\.|$)|uid(?:\\.|$))[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$",
      "description": "Reverse-domain host namespace; must not be or start with std, org.opentheme, or uid.",
      "examples": ["com.example.notes"],
      "x-opentheme-code": "OT-HOST-001",
      "x-opentheme-rule": "R-HOST-001"
    },
    "catalog": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "examples": ["1.0"]
    },
    "consumes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "contracts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tokens": {
      "$ref": "defs/tokens.schema.json#/$defs/tokenTree",
      "description": "Host extension tokens; paths are qualified as <host-id>/<local path> at resolution."
    },
    "contracts": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/hostContract" }
    },
    "layoutVariants": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/layoutVariant" },
      "description": "Map from region name to declared variants and default."
    },
    "$extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "layoutVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variants", "default"],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "default": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "hostContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description",
        "parts",
        "states",
        "properties",
        "defaults"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "<host-namespace>/<name>"
        },
        "version": {
          "$ref": "defs/metadata.schema.json#/$defs/version"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "default",
              "hover",
              "focus-visible",
              "pressed",
              "disabled",
              "selected",
              "invalid"
            ]
          }
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "color",
                "dimension",
                "fontFamily",
                "fontWeight",
                "number",
                "opacity",
                "duration",
                "cubicBezier",
                "strokeStyle",
                "border",
                "shadow",
                "typography",
                "density"
              ],
              "description": "The chapter 03 token types (research R4); any other type is OT-HOST-002."
            }
          }
        },
        "defaults": { "type": "object" },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["foreground", "background", "kind"],
            "additionalProperties": false,
            "properties": {
              "foreground": { "type": "string" },
              "background": { "type": "string" },
              "kind": {
                "enum": ["text", "large-text", "non-text", "disabled"]
              }
            }
          }
        },
        "interactiveParts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "x-opentheme-code": "OT-DOC-003",
  "x-opentheme-rule": "R-DOC-003"
}

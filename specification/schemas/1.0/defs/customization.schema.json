{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/defs/customization.schema.json",
  "title": "OpenTheme Customization Points",
  "description": "Customization points per data-model §9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["points"],
  "properties": {
    "points": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/point" },
      "description": "points: an array of at most 200 points",
      "examples": [[{ "id": "std.accent" }]]
    }
  },
  "$defs": {
    "pointId": {
      "type": "string",
      "oneOf": [
        { "pattern": "^std\\.[a-z][a-z0-9-]*$" },
        { "pattern": "^[a-z][a-z0-9-]*$" }
      ],
      "description": "std.<name> for standard points … or a theme-local identifier [a-z][a-z0-9-]*",
      "examples": ["std.accent", "brand-tint"],
      "x-opentheme-code": "OT-CUS-001",
      "x-opentheme-rule": "R-CUS-001"
    },
    "rangeNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "step"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "rangeColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gamut", "opaque"],
      "properties": {
        "gamut": { "const": "srgb" },
        "opaque": { "const": true }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": {
          "description": "Literal or alias, never a derivation",
          "oneOf": [
            { "$ref": "tokens.schema.json#/$defs/literal" }
          ]
        }
      }
    },
    "constraints": {
      "description": "Exactly one of: range { min, max, step }; range { gamut: \"srgb\", opaque: true }; enum [values]; or presets [{ id, label, value }]",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["range"],
          "properties": {
            "range": {
              "oneOf": [
                { "$ref": "#/$defs/rangeNumber" },
                { "$ref": "#/$defs/rangeColor" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enum"],
          "properties": {
            "enum": {
              "type": "array",
              "minItems": 1,
              "items": { "type": ["string", "number", "boolean"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presets"],
          "properties": {
            "presets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/preset" }
            }
          }
        }
      ]
    },
    "target": {
      "description": "1 to 16 token paths, or one context dimension (colorScheme, contrast, motion, density)",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimension"],
          "properties": {
            "dimension": {
              "enum": ["colorScheme", "contrast", "motion", "density"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["textScale"],
          "properties": {
            "textScale": { "const": "in-app" }
          }
        }
      ]
    },
    "point": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/pointId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "localized": { "$ref": "display-text.schema.json#/$defs/localized" },
        "target": { "$ref": "#/$defs/target" },
        "type": {
          "description": "A token type, or enum for dimension targets",
          "oneOf": [
            {
              "enum": [
                "color",
                "dimension",
                "fontFamily",
                "fontWeight",
                "number",
                "opacity",
                "duration",
                "cubicBezier",
                "strokeStyle",
                "border",
                "shadow",
                "typography",
                "density",
                "enum"
              ]
            }
          ]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "default": {
          "description": "Optional literal, or a preset id for preset points"
        },
        "effectiveRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "description": "Text-size point only: { min, max } for the effective text scale, with max ≥ 2"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/defs/tokens.schema.json",
  "title": "OpenTheme Token Grammars",
  "description": "Literal token value grammars and token member shape (data-model §4, research R4).",
  "$defs": {
    "pathSegment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64,
      "description": "Path segments match [a-z][a-z0-9-]*, at most 64 characters per segment.",
      "examples": ["secondary"],
      "x-opentheme-code": "OT-TOK-001",
      "x-opentheme-rule": "R-TOK-001"
    },
    "alias": {
      "type": "string",
      "pattern": "^\\{[a-z][a-z0-9./-]*\\}$",
      "maxLength": 258,
      "description": "Alias string of the form {path}; total path at most 256 characters.",
      "examples": ["{color.surface.base}"],
      "x-opentheme-code": "OT-TOK-001",
      "x-opentheme-rule": "R-TOK-001"
    },
    "familyName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._\\-]{0,63}$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Family-name grammar of letters, digits, spaces, -, _, and ., 1 to 64 characters.",
      "examples": ["Inter"],
      "x-opentheme-code": "OT-TOK-004",
      "x-opentheme-rule": "R-TOK-004"
    },
    "genericFamily": {
      "type": "string",
      "enum": [
        "serif",
        "sans-serif",
        "monospace",
        "cursive",
        "fantasy",
        "system-ui",
        "ui-serif",
        "ui-sans-serif",
        "ui-monospace",
        "ui-rounded",
        "math",
        "emoji",
        "fangsong"
      ],
      "description": "Closed list of generic font families.",
      "examples": ["sans-serif"]
    },
    "fontFamilyList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/familyName" },
          { "$ref": "#/$defs/genericFamily" }
        ]
      },
      "description": "Array of 1 to 8 family names, ending in a generic family",
      "examples": [["Inter", "system-ui", "sans-serif"]]
    },
    "color": {
      "type": "object",
      "required": ["colorSpace", "components"],
      "additionalProperties": false,
      "properties": {
        "colorSpace": { "enum": ["srgb", "oklch"] },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      },
      "description": "{ colorSpace: \"srgb\" | \"oklch\", components: [3 numbers in range], alpha?: 0..1, hex?: \"#rrggbb\" }",
      "examples": [
        { "colorSpace": "srgb", "components": [0.2, 0.3, 0.9], "alpha": 1 }
      ],
      "x-opentheme-code": "OT-TOK-004",
      "x-opentheme-rule": "R-TOK-004"
    },
    "dimension": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "const": "px" }
      },
      "description": "{ value: number, unit: \"px\" }",
      "examples": [{ "value": 16, "unit": "px" }]
    },
    "fontFamily": {
      "oneOf": [
        { "$ref": "#/$defs/fontFamilyList" },
        {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": { "$ref": "#/$defs/fontFamilyList" }
          },
          "additionalProperties": { "$ref": "#/$defs/fontFamilyList" },
          "description": "Optionally keyed by script"
        }
      ],
      "description": "Ordered font family fallback lists, optionally per script"
    },
    "fontWeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Integer 1 to 1000",
      "examples": [400]
    },
    "number": {
      "type": "number",
      "description": "Finite number within the role's range"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Number 0 to 1",
      "examples": [0.5]
    },
    "duration": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1000 },
        "unit": { "const": "ms" }
      },
      "description": "{ value: 0..1000, unit: \"ms\" }",
      "examples": [{ "value": 200, "unit": "ms" }]
    },
    "cubicBezier": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number" },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number" }
      ],
      "description": "[x1, y1, x2, y2] with x values in [0, 1]",
      "examples": [[0.4, 0, 0.2, 1]]
    },
    "strokeStyle": {
      "enum": ["solid", "dashed", "dotted"],
      "description": "solid | dashed | dotted",
      "examples": ["solid"]
    },
    "density": {
      "enum": ["compact", "standard", "comfortable"],
      "description": "compact | standard | comfortable",
      "examples": ["standard"]
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "style": { "oneOf": [{ "$ref": "#/$defs/strokeStyle" }, { "$ref": "#/$defs/alias" }] },
        "color": { "oneOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/alias" }] },
        "physical": { "type": "boolean" }
      },
      "description": "Composite border; members may carry physical: true"
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offsetX": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "offsetY": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "blur": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "spread": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "color": { "oneOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/alias" }] },
        "physical": { "type": "boolean" }
      },
      "description": "Composite shadow; members may carry physical: true"
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "oneOf": [{ "$ref": "#/$defs/fontFamily" }, { "$ref": "#/$defs/alias" }] },
        "fontWeight": { "oneOf": [{ "$ref": "#/$defs/fontWeight" }, { "$ref": "#/$defs/alias" }] },
        "fontSize": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "lineHeight": {
          "oneOf": [
            { "$ref": "#/$defs/number" },
            { "$ref": "#/$defs/dimension" },
            { "$ref": "#/$defs/alias" }
          ]
        },
        "letterSpacing": { "oneOf": [{ "$ref": "#/$defs/dimension" }, { "$ref": "#/$defs/alias" }] },
        "physical": { "type": "boolean" }
      },
      "description": "Composite typography; members may carry physical: true"
    },
    "literal": {
      "anyOf": [
        { "$ref": "#/$defs/color" },
        { "$ref": "#/$defs/dimension" },
        { "$ref": "#/$defs/fontFamily" },
        { "$ref": "#/$defs/fontWeight" },
        { "$ref": "#/$defs/number" },
        { "$ref": "#/$defs/opacity" },
        { "$ref": "#/$defs/duration" },
        { "$ref": "#/$defs/cubicBezier" },
        { "$ref": "#/$defs/strokeStyle" },
        { "$ref": "#/$defs/border" },
        { "$ref": "#/$defs/shadow" },
        { "$ref": "#/$defs/typography" },
        { "$ref": "#/$defs/density" },
        { "$ref": "#/$defs/alias" }
      ]
    },
    "tokenLeaf": {
      "type": "object",
      "description": "Leaf token. Exactly one of $value or $derive. Unknown $ members are errors (OT-DOC-003); enforced by schema additionalProperties and semantic validation.",
      "additionalProperties": false,
      "properties": {
        "$type": {
          "enum": [
            "color",
            "dimension",
            "fontFamily",
            "fontWeight",
            "number",
            "opacity",
            "duration",
            "cubicBezier",
            "strokeStyle",
            "border",
            "shadow",
            "typography",
            "density"
          ]
        },
        "$value": { "$ref": "#/$defs/literal" },
        "$derive": { "$ref": "derivation.schema.json#/$defs/derive" },
        "$description": { "type": "string" },
        "$deprecated": {
          "oneOf": [
            { "const": true },
            {
              "type": "object",
              "required": ["replacement"],
              "properties": {
                "replacement": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          ]
        },
        "$extensions": { "type": "object" }
      },
      "oneOf": [
        { "required": ["$value"], "not": { "required": ["$derive"] } },
        { "required": ["$derive"], "not": { "required": ["$value"] } }
      ],
      "examples": [
        {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.1, 0.1, 0.1] }
        }
      ]
    },
    "tokenTree": {
      "type": "object",
      "description": "Nested token groups. Groups may declare $type for inheritance; leaves use $value or $derive. Allowed $ members: $type, $description, $deprecated, $extensions.",
      "properties": {
        "$type": {
          "enum": [
            "color",
            "dimension",
            "fontFamily",
            "fontWeight",
            "number",
            "opacity",
            "duration",
            "cubicBezier",
            "strokeStyle",
            "border",
            "shadow",
            "typography",
            "density"
          ]
        },
        "$description": { "type": "string" },
        "$deprecated": true,
        "$extensions": { "type": "object" }
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/tokenLeaf" },
          { "$ref": "#/$defs/tokenTree" }
        ]
      }
    },
    "tokenNode": { "$ref": "#/$defs/tokenLeaf" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/defs/seeds.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "colorSchemes",
    "seeds"
  ],
  "properties": {
    "colorSchemes": {
      "type": "object",
      "required": [
        "supported",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Non-empty set drawn from light, dark, and declared variants",
          "examples": [
            [
              "light",
              "dark"
            ]
          ],
          "x-opentheme-code": "OT-TOK-010",
          "x-opentheme-rule": "R-TOK-010"
        },
        "default": {
          "type": "string",
          "description": "One of supported",
          "examples": [
            "light"
          ]
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "fallback"
            ],
            "properties": {
              "fallback": {
                "enum": [
                  "light",
                  "dark"
                ]
              }
            }
          }
        }
      }
    },
    "seeds": {
      "type": "object",
      "required": [
        "fontFamily"
      ],
      "properties": {
        "fontFamily": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "tokens.schema.json#/$defs/familyName"
          },
          "description": "Ordered font family fallback list ending in a generic family",
          "examples": [
            [
              "system-ui",
              "sans-serif"
            ]
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "description": "Per-scheme seeds: background, foreground, accent (opaque)",
        "required": [
          "background",
          "foreground",
          "accent"
        ],
        "properties": {
          "background": {
            "$ref": "#/$defs/opaqueColor"
          },
          "foreground": {
            "$ref": "#/$defs/opaqueColor"
          },
          "accent": {
            "$ref": "#/$defs/opaqueColor"
          }
        }
      }
    }
  },
  "$defs": {
    "opaqueColor": {
      "type": "object",
      "required": [
        "colorSpace",
        "components"
      ],
      "properties": {
        "colorSpace": {
          "enum": [
            "srgb",
            "oklch"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "alpha": {
          "const": 1,
          "x-opentheme-code": "OT-TOK-011",
          "x-opentheme-rule": "R-TOK-011"
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "description": "Opaque sRGB or OKLCH color (seeds must not be translucent)"
    }
  }
}

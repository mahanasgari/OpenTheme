{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentheme.org/schemas/1.0/fixture.schema.json",
  "title": "OpenTheme Conformance Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "rules", "description", "input", "expect"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "validate",
        "validate-host",
        "resolve",
        "canonicalize",
        "flatten",
        "export-check",
        "compare-versions",
        "migrate",
        "kernel",
        "validate-preferences",
        "accessibility-report"
      ],
      "description": "Conformance request kind.",
      "examples": ["validate"]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^R-[A-Z0-9]+-[0-9]{3}$" },
      "description": "Rules exercised by this fixture.",
      "examples": [["R-DOC-001"]]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable fixture purpose.",
      "examples": ["Rejects a duplicate JSON member."]
    },
    "profile": {
      "type": "string",
      "description": "Optional simulated previous-major or other profile.",
      "examples": ["previous-major"]
    },
    "input": {
      "description": "Inline document, $file reference, or generate instruction.",
      "oneOf": [
        { "type": "object" },
        {
          "type": "object",
          "required": ["$file"],
          "additionalProperties": false,
          "properties": {
            "$file": {
              "type": "string",
              "pattern": "^(conformance/fixtures/|specification/(themes|hosts|examples)/).+",
              "description": "Path restricted to fixtures or published themes/hosts/examples."
            }
          }
        },
        {
          "type": "object",
          "required": ["generate"],
          "additionalProperties": false,
          "properties": {
            "generate": {
              "type": "object",
              "required": ["generator"],
              "properties": {
                "generator": {
                  "type": "string",
                  "enum": [
                    "pad-bytes",
                    "nest-depth",
                    "token-count",
                    "reference-chain",
                    "derivation-depth",
                    "repeat-member"
                  ]
                },
                "params": { "type": "object" }
              }
            }
          }
        }
      ]
    },
    "expect": {
      "type": "object",
      "description": "Kind-specific expectations.",
      "examples": [{ "valid": false, "diagnostics": [{ "code": "OT-DOC-002" }] }]
    }
  }
}

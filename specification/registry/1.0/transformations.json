        },
        {
          "name": "target",
          "type": "number",
          "domain": {
            "min": 1,
            "max": 21
          },
          "optional": false
        }
      ],
      "example": {
        "$derive": {
          "op": "color.contrast-adjust",
          "args": {
            "color": "{seed.accent}"
          }
        }
      }
    },

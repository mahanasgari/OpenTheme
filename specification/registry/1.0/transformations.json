{
  "version": "1.0.0-draft.4",
  "transformations": [
    {
      "id": "color.mix",
      "description": "Interpolate two colors in premultiplied OKLab.",
      "outputType": "color",
      "effortCost": 1,
      "arguments": [
        {
          "name": "color",
          "type": "color",
          "optional": false
        },
        {
          "name": "toward",
          "type": "color",
          "optional": false
        },
        {
          "name": "ratio",
          "type": "number",
          "domain": {
            "min": 0,
            "max": 1
          },
          "optional": false
        }
      ],
      "example": {
        "$derive": {
          "op": "color.mix",
          "args": {
            "color": "{seed.accent}"
          }
        }
      }
    },
    {
      "id": "color.lightness",
      "description": "Add a lightness delta in OKLab, then gamut-map.",
      "outputType": "color",
      "effortCost": 1,
      "arguments": [
        {
          "name": "color",
          "type": "color",
          "optional": false
        },
        {
          "name": "delta",
          "type": "number",
          "domain": {
            "min": -1,
            "max": 1
          },
          "optional": false
        }

    {
      "id": "color.composite",
      "description": "Source-over composite onto an opaque backdrop in sRGB.",
      "outputType": "color",
      "effortCost": 1,
      "arguments": [
        {
          "name": "color",
          "type": "color",
          "optional": false
        },
        {
          "name": "backdrop",
          "type": "color",
          "domain": {
            "opaque": true
          },
          "optional": false
        }
      ],
      "example": {
        "$derive": {
          "op": "color.composite",
          "args": {
            "color": "{seed.accent}"
          }
        }
      }
    },
    {
      "id": "color.contrast-select",
      "description": "Pick first candidate meeting contrast target, else best.",
      "outputType": "color",
      "effortCost": 12,
      "arguments": [
        {
          "name": "backgrounds",
          "type": "color[]",
          "domain": {
            "minItems": 1,
            "maxItems": 4,
            "opaque": true
          },
          "optional": false
        },
        {
          "name": "candidates",
          "type": "color[]",
          "domain": {
            "minItems": 1,
            "maxItems": 8
          },
          "optional": false
        },
        {
          "name": "target",
          "type": "number",
          "domain": {
            "min": 1,
            "max": 21
          },
          "optional": false
        }
      ],
      "example": {
        "$derive": {
          "op": "color.contrast-select",
          "args": {
            "backgrounds": "{seed.accent}"
          }
        }
      }
    },
    {

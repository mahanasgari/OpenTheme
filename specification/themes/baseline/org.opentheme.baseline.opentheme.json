{
  "opentheme": "1.0",
  "id": "org.opentheme.baseline",
  "version": "1.0.0",
  "name": "OpenTheme Baseline",
  "description": "Specification baseline theme. Seed-only; all semantics come from registry defaults.",
  "author": { "name": "OpenTheme Project" },
  "license": "Apache-2.0",
  "provenance": { "origin": "specification-baseline" },
  "compatibility": { "catalog": "1.0" },
  "colorSchemes": {
    "supported": ["light", "dark"],
    "default": "light"
  },
  "seeds": {
    "light": {
      "background": { "colorSpace": "srgb", "components": [0.98, 0.97, 0.95] },
      "foreground": { "colorSpace": "srgb", "components": [0.12, 0.12, 0.14] },
      "accent": { "colorSpace": "oklch", "components": [0.55, 0.12, 250] }
    },
    "dark": {
      "background": { "colorSpace": "srgb", "components": [0.12, 0.12, 0.14] },
      "foreground": { "colorSpace": "srgb", "components": [0.92, 0.92, 0.94] },
      "accent": { "colorSpace": "oklch", "components": [0.7, 0.12, 250] }
    },
    "fontFamily": ["system-ui", "sans-serif"]
  },
  "customization": {
    "points": [
      { "id": "std.accent" },
      { "id": "std.color-scheme" },
      { "id": "std.contrast" },
      { "id": "std.text-size" },
      { "id": "std.density" },
      { "id": "std.corner-roundness" },
      { "id": "std.motion" }
    ]
  }
}
